From 20e9cf1266fb7b536f94ba8c64b09d50b685df22 Mon Sep 17 00:00:00 2001
From: huzhaolun <huzhaolun@qq.com>
Date: Wed, 28 Oct 2026 20:37:16 +0800
Subject: [PATCH 04/11] feat(discovery): re-apply discovery when discovery-url
 is saved

A save now triggers one mediator restart so the new endpoint is fetched on the
next attempt instead of after an unrelated connection failure.
---
 libs/hbb_common    | 2 +-
 src/flutter_ffi.rs | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/libs/hbb_common b/libs/hbb_common
index fae47e024..edefa08b7 160000
--- a/libs/hbb_common
+++ b/libs/hbb_common
@@ -1 +1 @@
-Subproject commit fae47e024dd83cef6aaecde0aa7d11731df11649
+Subproject commit edefa08b798b7fbf70b274a4cdbf701c9e06f7a3
diff --git a/src/flutter_ffi.rs b/src/flutter_ffi.rs
index 8473e38fa..02f127700 100644
--- a/src/flutter_ffi.rs
+++ b/src/flutter_ffi.rs
@@ -1065,6 +1065,7 @@ pub fn main_set_option(key: String, value: String) -> hbb_common::anyhow::Result
     // If `is_allow_tls_fallback` and https proxy is used, we need to restart rendezvous mediator.
     // No need to check if https proxy is used, because this option does not change frequently
     // and restarting mediator is safe even https proxy is not used.
+    let is_discovery_url = key.eq(crate::discovery::OPTION_DISCOVERY_URL);
     let is_allow_tls_fallback = key.eq(keys::OPTION_ALLOW_INSECURE_TLS_FALLBACK);
     if is_allow_tls_fallback
         || key.eq("custom-rendezvous-server")
@@ -1083,6 +1084,11 @@ pub fn main_set_option(key: String, value: String) -> hbb_common::anyhow::Result
     } else {
         set_option(key, value.clone());
     }
+    if is_discovery_url {
+        // Reconnect now so the new endpoint is fetched at the next attempt instead of after some
+        // unrelated connection failure.
+        crate::rendezvous_mediator::RendezvousMediator::restart();
+    }
     Ok(())
 }
 
