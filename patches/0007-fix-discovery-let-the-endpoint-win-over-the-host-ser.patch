From f87de5eed5144ec5b4f8b854c70ed36f4183eea2 Mon Sep 17 00:00:00 2001
From: huzhaolun <huzhaolun@qq.com>
Date: Fri, 30 Oct 2026 21:28:11 +0800
Subject: [PATCH 07/10] fix(discovery): let the endpoint win over the host
 service

On an installed Windows build the client asks the service for the rendezvous
address and the service's answer predates the endpoint, so the discovered
server was computed and then discarded in favour of the official one. The
resolution now prefers the endpoint on every platform, including the mobile
path that reads the option directly.
---
 src/common.rs | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/common.rs b/src/common.rs
index 843ae2a7f..d2e7f00c5 100644
--- a/src/common.rs
+++ b/src/common.rs
@@ -816,6 +816,9 @@ pub async fn get_rendezvous_server(ms_timeout: u64) -> (String, Vec<String>, boo
 #[inline]
 #[cfg(any(target_os = "android", target_os = "ios"))]
 fn get_rendezvous_server_(_ms_timeout: u64) -> (String, Vec<String>) {
+    if let Some(id_server) = crate::discovery::id_server() {
+        return (id_server, Vec::new());
+    }
     (
         Config::get_rendezvous_server(),
         Config::get_rendezvous_servers(),
@@ -825,6 +828,9 @@ fn get_rendezvous_server_(_ms_timeout: u64) -> (String, Vec<String>) {
 #[inline]
 #[cfg(not(any(target_os = "android", target_os = "ios")))]
 async fn get_rendezvous_server_(ms_timeout: u64) -> (String, Vec<String>) {
+    if let Some(id_server) = crate::discovery::id_server() {
+        return (id_server, Vec::new());
+    }
     crate::ipc::get_rendezvous_server(ms_timeout).await
 }
 
