From 6d0d9c6c8de0c788800b99b7b4cd8e8f5b39ea30 Mon Sep 17 00:00:00 2001
From: huzhaolun <huzhaolun@qq.com>
Date: Wed, 28 Oct 2026 20:37:15 +0800
Subject: [PATCH 2/6] feat(discovery): resolve the rendezvous server through
 discovery

Apply the discovered value before every connect attempt, which covers both
the server list path and the single server path that client.rs reads.
---
 src/rendezvous_mediator.rs | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/rendezvous_mediator.rs b/src/rendezvous_mediator.rs
index 042d62b6c..3972b68e6 100644
--- a/src/rendezvous_mediator.rs
+++ b/src/rendezvous_mediator.rs
@@ -272,6 +272,7 @@ impl RendezvousMediator {
     }
 
     pub async fn start_all() {
+        crate::discovery::sync().await;
         crate::test_nat_type();
         if config::is_outgoing_only() {
             loop {
@@ -311,6 +312,7 @@ impl RendezvousMediator {
                 && !crate::platform::installing_service()
             {
                 let mut futs = Vec::new();
+                crate::discovery::sync().await;
                 let servers = Config::get_rendezvous_servers();
                 SHOULD_EXIT.store(false, Ordering::SeqCst);
                 MANUAL_RESTARTED.store(false, Ordering::SeqCst);
@@ -1319,6 +1321,9 @@ impl RendezvousMediator {
     }
 
     fn get_relay_server(&self, provided_by_rendezvous_server: String) -> String {
+        if let Some(relay_server) = crate::discovery::relay_server() {
+            return relay_server;
+        }
         let mut relay_server = Config::get_option("relay-server");
         if relay_server.is_empty() {
             relay_server = provided_by_rendezvous_server;
