From 2e6d360bf863e3b07336fb847eb3934d644a53eb Mon Sep 17 00:00:00 2001
From: huzhaolun <huzhaolun@qq.com>
Date: Thu, 29 Oct 2026 18:46:32 +0800
Subject: [PATCH 09/11] fix(discovery): apply a saved endpoint immediately

Saving discovery-url only asked the mediator to reconnect, so a stopped
service - which never runs the reconnect loop - kept the old servers until the
client restarted. The option now fetches and injects in place, and the
no-endpoint path logs at trace level so a silent no-op is visible.
---
 src/discovery.rs   | 36 ++++++++++++++++++++++++++++++++++++
 src/flutter_ffi.rs |  5 +++--
 2 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/src/discovery.rs b/src/discovery.rs
index 306b39604..16fe03653 100644
--- a/src/discovery.rs
+++ b/src/discovery.rs
@@ -76,8 +76,10 @@ pub async fn sync() {
     let url = url.trim().to_owned();
     if url.is_empty() {
         if !STATE.lock().unwrap().is_active() {
+            log::trace!("discovery: no endpoint configured");
             return;
         }
+        log::info!("discovery: endpoint cleared, back to the manual settings");
         apply(None);
         return;
     }
@@ -117,6 +119,40 @@ pub async fn sync() {
     apply(cached.as_ref());
 }
 
+/// Applies the discovery endpoint right now, from a non-async caller.
+///
+/// Saving the option has to take effect without waiting for the next reconnect, and a stopped
+/// service never runs the reconnect loop at all, so the caller cannot rely on it.
+pub fn refresh_blocking() {
+    let url = Config::get_option(OPTION_DISCOVERY_URL);
+    let url = url.trim().to_owned();
+    if url.is_empty() {
+        apply(None);
+        return;
+    }
+    // Drop the cache so the next attempt fetches the endpoint the user just saved.
+    {
+        let mut cache = CACHE.lock().unwrap();
+        cache.last_attempt = None;
+        cache.last_url = url.clone();
+    }
+    match fetch(&url) {
+        Ok(value) => {
+            {
+                let mut cache = CACHE.lock().unwrap();
+                cache.last_attempt = Some(Instant::now());
+                cache.value = Some(value.clone());
+            }
+            apply(Some(&value));
+        }
+        Err(err) => {
+            log::warn!("discovery: {url}: {err}");
+            let cached = CACHE.lock().unwrap().value.clone();
+            apply(cached.as_ref());
+        }
+    }
+}
+
 /// The announced API server, when it is currently overridden.
 pub fn api_server() -> Option<String> {
     non_empty(STATE.lock().unwrap().active.api_server.clone())
diff --git a/src/flutter_ffi.rs b/src/flutter_ffi.rs
index 02f127700..fcb853027 100644
--- a/src/flutter_ffi.rs
+++ b/src/flutter_ffi.rs
@@ -1085,8 +1085,9 @@ pub fn main_set_option(key: String, value: String) -> hbb_common::anyhow::Result
         set_option(key, value.clone());
     }
     if is_discovery_url {
-        // Reconnect now so the new endpoint is fetched at the next attempt instead of after some
-        // unrelated connection failure.
+        // Apply now: a stopped service never runs the reconnect loop, so waiting for the next
+        // attempt would leave the saved endpoint inert until the client is restarted.
+        crate::discovery::refresh_blocking();
         crate::rendezvous_mediator::RendezvousMediator::restart();
     }
     Ok(())
