+            &value.online_server,
+            &state.active.online_server,
+            "online-server",
+        ),
         (&value.key, &state.active.key, "key"),
     ] {
         if !announced.is_empty() && announced != applied {
@@ -280,6 +296,7 @@ fn parse_body(body: &str) -> Option<Discovered> {
