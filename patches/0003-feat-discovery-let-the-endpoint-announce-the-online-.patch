From f4c4f2b0a7f6a131a68224be004c0b4799163b1e Mon Sep 17 00:00:00 2001
From: huzhaolun <huzhaolun@qq.com>
Date: Fri, 30 Oct 2026 11:12:10 +0800
Subject: [PATCH 3/6] feat(discovery): let the endpoint announce the
 online-status server

The client derives the online-status port as the rendezvous port minus one,
which only holds when the services sit on adjacent ports of one host. A
deployment behind random port mapping has no such neighbour, so the address
book showed every peer offline. An optional online_server field now supplies
the address directly; without it the previous derivation is unchanged.
---
 src/client.rs    |  5 +++++
 src/discovery.rs | 34 ++++++++++++++++++++++++++++++++++
 2 files changed, 39 insertions(+)

diff --git a/src/client.rs b/src/client.rs
index 597dc863a..b224b97e4 100644
--- a/src/client.rs
+++ b/src/client.rs
@@ -5339,6 +5339,11 @@ pub mod peer_online {
     }
 
     async fn create_online_stream() -> ResultType<Stream> {
+        // A discovered deployment may expose each service on its own mapped port, where the
+        // port-minus-one neighbour does not exist; use the announced address when there is one.
+        if let Some(online_server) = crate::discovery::online_server() {
+            return connect_tcp(online_server, CONNECT_TIMEOUT).await;
+        }
         let (rendezvous_server, _servers, _contained) =
             crate::get_rendezvous_server(READ_TIMEOUT).await;
         let tmp: Vec<&str> = rendezvous_server.split(":").collect();
