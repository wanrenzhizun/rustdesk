From bcac4c6f9cbdfb27d16146c948fe1c20dc913e24 Mon Sep 17 00:00:00 2001
From: huzhaolun <huzhaolun@qq.com>
Date: Wed, 28 Oct 2026 20:37:17 +0800
Subject: [PATCH 5/6] feat(discovery): add discovery URL to the network
 settings dialog

Desktop and mobile share showServerSettingsWithValue, so one dialog change
covers both. The shareable server config string carries the new field.
---
 flutter/lib/common.dart                | 25 +++++++++++++++++++--
 flutter/lib/mobile/widgets/dialog.dart | 31 ++++++++++++++++++++++++--
 2 files changed, 52 insertions(+), 4 deletions(-)

diff --git a/flutter/lib/common.dart b/flutter/lib/common.dart
index b80e0b5f9..67d7104f1 100644
--- a/flutter/lib/common.dart
+++ b/flutter/lib/common.dart
@@ -2923,13 +2923,19 @@ class ServerConfig {
   late String relayServer;
   late String apiServer;
   late String key;
+  late String discoveryUrl;
 
   ServerConfig(
-      {String? idServer, String? relayServer, String? apiServer, String? key}) {
+      {String? idServer,
+      String? relayServer,
+      String? apiServer,
+      String? key,
+      String? discoveryUrl}) {
     this.idServer = idServer?.trim() ?? '';
     this.relayServer = relayServer?.trim() ?? '';
     this.apiServer = apiServer?.trim() ?? '';
     this.key = key?.trim() ?? '';
+    this.discoveryUrl = discoveryUrl?.trim() ?? '';
   }
 
   /// decode from shared string (from user shared or rustdesk-server generated)
@@ -2949,6 +2955,7 @@ class ServerConfig {
     relayServer = json['relay'] ?? '';
     apiServer = json['api'] ?? '';
     key = json['key'] ?? '';
+    discoveryUrl = json['discovery'] ?? '';
   }
 
   /// encode to shared string
@@ -2959,6 +2966,7 @@ class ServerConfig {
     config['relay'] = relayServer.trim();
     config['api'] = apiServer.trim();
     config['key'] = key.trim();
+    config['discovery'] = discoveryUrl.trim();
     return base64UrlEncode(Uint8List.fromList(jsonEncode(config).codeUnits))
         .split('')
         .reversed
@@ -2970,7 +2978,8 @@ class ServerConfig {
       : idServer = options['custom-rendezvous-server'] ?? "",
         relayServer = options['relay-server'] ?? "",
         apiServer = options['api-server'] ?? "",
-        key = options['key'] ?? "";
+        key = options['key'] ?? "",
+        discoveryUrl = options['discovery-url'] ?? "";
 }
 
 Widget dialogButton(String text,
@@ -3594,11 +3603,21 @@ Future<bool> setServerConfig(
   config.relayServer = removeEndSlash(config.relayServer.trim());
   config.apiServer = removeEndSlash(config.apiServer.trim());
   config.key = config.key.trim();
+  config.discoveryUrl = config.discoveryUrl.trim();
+  if (config.discoveryUrl.isNotEmpty &&
+      !config.discoveryUrl.startsWith('https://')) {
+    showToast(
+        '${translate("Discovery URL")}: ${translate("invalid_http")}');
+    return false;
+  }
   if (controllers != null) {
     controllers[0].text = config.idServer;
     controllers[1].text = config.relayServer;
     controllers[2].text = config.apiServer;
     controllers[3].text = config.key;
+    if (controllers.length > 4) {
+      controllers[4].text = config.discoveryUrl;
+    }
   }
   // id
   if (config.idServer.isNotEmpty && errMsgs != null) {
@@ -3633,6 +3652,8 @@ Future<bool> setServerConfig(
   await bind.mainSetOption(key: 'relay-server', value: config.relayServer);
   await bind.mainSetOption(key: 'api-server', value: config.apiServer);
   await bind.mainSetOption(key: 'key', value: config.key);
+  await bind.mainSetOption(
+      key: 'discovery-url', value: config.discoveryUrl);
   final newApiServer = await bind.mainGetApiServer();
   if (oldApiServer.isNotEmpty &&
       oldApiServer != newApiServer &&
diff --git a/flutter/lib/mobile/widgets/dialog.dart b/flutter/lib/mobile/widgets/dialog.dart
index 4e8179e8f..f713864cb 100644
--- a/flutter/lib/mobile/widgets/dialog.dart
+++ b/flutter/lib/mobile/widgets/dialog.dart
@@ -77,12 +77,14 @@ void showServerSettingsWithValue(
   final relayCtrl = TextEditingController(text: serverConfig.relayServer);
   final apiCtrl = TextEditingController(text: serverConfig.apiServer);
   final keyCtrl = TextEditingController(text: serverConfig.key);
+  final discoveryCtrl =
+      TextEditingController(text: serverConfig.discoveryUrl);
 
   RxString idServerMsg = ''.obs;
   RxString relayServerMsg = ''.obs;
   RxString apiServerMsg = ''.obs;
 
-  final controllers = [idCtrl, relayCtrl, apiCtrl, keyCtrl];
+  final controllers = [idCtrl, relayCtrl, apiCtrl, keyCtrl, discoveryCtrl];
   final errMsgs = [
     idServerMsg,
     relayServerMsg,
@@ -101,7 +103,8 @@ void showServerSettingsWithValue(
               idServer: idCtrl.text.trim(),
               relayServer: relayCtrl.text.trim(),
               apiServer: apiCtrl.text.trim(),
-              key: keyCtrl.text.trim()));
+              key: keyCtrl.text.trim(),
+              discoveryUrl: discoveryCtrl.text.trim()));
       setState(() {
         isInProgress = false;
       });
@@ -191,6 +194,30 @@ void showServerSettingsWithValue(
                   ),
                   SizedBox(height: 8),
                   buildField('Key', keyCtrl, ''),
+                  SizedBox(height: 8),
+                  buildField(
+                    translate('Discovery URL'),
+                    discoveryCtrl,
+                    '',
+                    validator: (v) {
+                      if (v != null &&
+                          v.isNotEmpty &&
+                          !v.startsWith('https://')) {
+                        return translate("invalid_http");
+                      }
+                      return null;
+                    },
+                  ),
+                  Padding(
+                    padding: EdgeInsetsDirectional.only(
+                      start: isDesktop || isWeb ? labelWidth + labelSpacing : 0,
+                      top: 4,
+                    ),
+                    child: Text(
+                      translate('discovery_url_tip'),
+                      style: const TextStyle(fontSize: 12, color: Colors.grey),
+                    ),
+                  ),
                   if (isInProgress)
                     Padding(
                       padding: EdgeInsets.only(top: 8),
-- 
