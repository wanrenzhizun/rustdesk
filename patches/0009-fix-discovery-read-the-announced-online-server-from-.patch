From aaa8e4217e07f88e0c085b1c931aa8b465b57169 Mon Sep 17 00:00:00 2001
From: huzhaolun <huzhaolun@qq.com>
Date: Fri, 30 Oct 2026 22:08:27 +0800
Subject: [PATCH 09/11] fix(discovery): read the announced online server from
 the options too

The client derives the online-status address as the rendezvous port minus one, which only holds
when the two stay adjacent on one host. The host knows the announced address and already ships it
in the options, but only the host itself could see its own state, so every other process kept
deriving the neighbour port and the peer list stayed offline.
---
 src/discovery.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/discovery.rs b/src/discovery.rs
index 7a535b84c..f4471ab3e 100644
--- a/src/discovery.rs
+++ b/src/discovery.rs
@@ -14,6 +14,7 @@ const WATCH_INTERVAL: std::time::Duration = std::time::Duration::from_secs(2);
 
 /// Option holding the discovery endpoint. Empty means the feature is off.
 pub const OPTION_DISCOVERY_URL: &str = "discovery-url";
+const OPTION_ONLINE_SERVER: &str = "online-server";
 
 const CACHE_TTL: Duration = Duration::from_secs(60);
 const FETCH_TIMEOUT: Duration = Duration::from_secs(3);
@@ -211,6 +212,7 @@ pub fn api_server() -> Option<String> {
 /// endpoints share a host and stay adjacent, as they do on an unmapped rustdesk-server.
 pub fn online_server() -> Option<String> {
     non_empty(STATE.lock().unwrap().active.online_server.clone())
+        .or_else(|| non_empty(Config::get_option(OPTION_ONLINE_SERVER)))
 }
 
 /// The announced relay server, when it is currently overridden.
