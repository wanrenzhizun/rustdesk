diff --git a/flutter/lib/common.dart b/flutter/lib/common.dart
index 67d7104f1..8c17137b3 100644
--- a/flutter/lib/common.dart
+++ b/flutter/lib/common.dart
@@ -3605,7 +3605,8 @@ Future<bool> setServerConfig(
   config.key = config.key.trim();
   config.discoveryUrl = config.discoveryUrl.trim();
   if (config.discoveryUrl.isNotEmpty &&
-      !config.discoveryUrl.startsWith('https://')) {
+      !config.discoveryUrl.startsWith('https://') &&
+      !config.discoveryUrl.startsWith('http://')) {
     showToast(
         '${translate("Discovery URL")}: ${translate("invalid_http")}');
     return false;
diff --git a/flutter/lib/mobile/widgets/dialog.dart b/flutter/lib/mobile/widgets/dialog.dart
index 3b6de7148..ba423405c 100644
--- a/flutter/lib/mobile/widgets/dialog.dart
+++ b/flutter/lib/mobile/widgets/dialog.dart
@@ -298,9 +298,12 @@ void showDiscoveryUrlDialogWithValue(
   final urlCtrl = TextEditingController(text: current);
   final errMsg = ''.obs;
   dialogManager.show((setState, close, context) {
+    urlCtrl.addListener(() => setState(() {}));
     Future<bool> submit() async {
       final value = urlCtrl.text.trim();
-      if (value.isNotEmpty && !value.startsWith('https://')) {
+      if (value.isNotEmpty &&
+          !value.startsWith('https://') &&
+          !value.startsWith('http://')) {
         errMsg.value = translate('invalid_http');
         return false;
       }
@@ -352,6 +355,22 @@ void showDiscoveryUrlDialogWithValue(
                       style: const TextStyle(fontSize: 12, color: Colors.grey),
                     ),
                   ),
+                  Obx(() {
+                    final insecure = urlCtrl.text.trim().startsWith('http://');
+                    if (!insecure) return const SizedBox.shrink();
+                    return Padding(
+                      padding: EdgeInsetsDirectional.only(
+                        start:
+                            isDesktop || isWeb ? labelWidth + labelSpacing : 0,
+                        top: 4,
+                      ),
+                      child: Text(
+                        translate('discovery_url_insecure_tip'),
+                        style: const TextStyle(
+                            fontSize: 12, color: Colors.orange),
+                      ),
+                    );
+                  }),
                 ],
               )),
         ),
